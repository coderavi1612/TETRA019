{
  "pitch_deck": {
    "mandatory": [
      "company_identity.company_name",
      "fundraising_ask.amount_raising",
      "fundraising_ask.instrument_type",
      "fundraising_ask.valuation",
      "fundraising_ask.use_of_funds",
      "fundraising_ask.expected_runway_after_raise",
      "traction.revenue",
      "traction.monthly_revenue",
      "traction.monthly_growth_rate",
      "traction.customer_count",
      "financial_highlights.revenue",
      "financial_highlights.cash_balance",
      "financial_highlights.burn_rate",
      "financial_highlights.runway",
      "market_opportunity.market_size_tam",
      "market_opportunity.market_size_sam",
      "market_opportunity.market_size_som",
      "team.founders",
      "financial_projection_summary.forecast_revenue",
      "financial_projection_summary.forecast_growth_rate"
    ],
    "optional": [
      "problem_and_solution.*",
      "business_model.*",
      "go_to_market.*",
      "competition.*",
      "historical_performance.period_summaries",
