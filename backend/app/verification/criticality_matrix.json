      "shareholders[].number_of_shares_or_equivalent",
      "shareholders[].ownership_percentage",
      "founders[].founder_name",
      "founders[].equity_split_percentage",
      "investors[].investor_name",
      "investors[].amount_invested",
      "investors[].ownership_percentage",
      "esop.total_pool_size",
      "esop.pool_percentage",
      "funding_history[].round_name",
      "funding_history[].amount_raised",
      "funding_history[].pre_money_valuation",
      "funding_history[].post_money_valuation",
      "funding_history[].date_of_closing",
